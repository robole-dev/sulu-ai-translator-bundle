{
    "name": "robole/sulu-ai-translator-bundle",
    "description": "Translate any type of content using DeepL",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.2",
        "sulu/sulu": "^3.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/security-core": "^7.4",
        "deeplcom/deepl-php": "^1.7"
    },
    "homepage": "https://github.com/robole-dev/sulu-ai-translator-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Robole\\SuluAITranslatorBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Felix Sänger",
            "email": "felix.saenger@robole.de"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "scripts": {
        "php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix"
    }
}
